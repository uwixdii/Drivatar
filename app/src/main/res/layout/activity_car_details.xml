<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Название машины -->
        <TextView
            android:id="@+id/tvCarName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Название машины"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Год выпуска -->
        <TextView
            android:id="@+id/tvCarYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Год выпуска"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Цена -->
        <TextView
            android:id="@+id/tvCarPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цена"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Статус бронирования -->
        <TextView
            android:id="@+id/tvReservedBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/holo_red_dark" />

        <!-- Кнопка бронирования -->
        <Button
            android:id="@+id/btnReserve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Забронировать"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Кнопка отмены бронирования -->
        <Button
            android:id="@+id/btnCancelReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отменить бронирование"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Кнопка действия администратора -->
        <Button
            android:id="@+id/btnAdminActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Действия администратора"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Поле для изменения данных машины (только для администратора) -->
        <LinearLayout
            android:id="@+id/adminEditSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etCarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Введите новое название машины"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etCarYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Введите новый год выпуска"
                android:layout_marginBottom="8dp"
                android:inputType="number" />

            <EditText
                android:id="@+id/etCarPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Введите новую цену"
                android:layout_marginBottom="8dp"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/btnUpdateCar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Обновить данные машины"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
