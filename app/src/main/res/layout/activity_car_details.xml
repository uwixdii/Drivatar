<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Данные машины -->
    <TextView
        android:id="@+id/tvCarName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название машины"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCarYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Год выпуска"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvCarPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Цена"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvCarColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Цвет"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvCarMileage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пробег"
        android:layout_marginBottom="8dp" />

    <!-- Информация о бронировании -->
    <TextView
        android:id="@+id/tvReservedBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Забронировано пользователем"
        android:layout_marginBottom="16dp" />

    <!-- Кнопки -->
    <Button
        android:id="@+id/btnCancelReservation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Отменить бронирование"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnHideCar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Скрыть машину"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDeleteCar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Удалить машину"
        android:visibility="gone" />
</LinearLayout>
