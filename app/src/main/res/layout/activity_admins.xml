<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnViewReservedCars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Просмотр забронированных машин" />

    <Button
        android:id="@+id/btnViewAvailableCars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Просмотр свободных машин" />

    <Button
        android:id="@+id/btnAddCar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить машину" />

    <Button
        android:id="@+id/btnManageUsers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Управление пользователями" />
</LinearLayout>
