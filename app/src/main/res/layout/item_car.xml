<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Название машины -->
    <TextView
        android:id="@+id/carName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Car Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Год -->
    <TextView
        android:id="@+id/carYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Year"
        android:layout_marginBottom="4dp" />

    <!-- Цена -->
    <TextView
        android:id="@+id/carPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Price"
        android:layout_marginBottom="4dp" />

    <!-- Цвет -->
    <TextView
        android:id="@+id/carColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Color"
        android:layout_marginBottom="4dp" />

    <!-- Пробег -->
    <TextView
        android:id="@+id/carMileage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mileage"
        android:layout_marginBottom="8dp" />

    <!-- Забронировано пользователем -->
    <TextView
        android:id="@+id/reservedByText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Забронировано: Иван Иванов"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <!-- Кнопки -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <!-- Кнопка Подробнее -->
        <Button
            android:id="@+id/detailsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Подробнее"
            android:layout_marginEnd="8dp" />

        <!-- Кнопка Забронировать -->
        <Button
            android:id="@+id/bookButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Забронировать"
            android:layout_marginEnd="8dp" />

        <!-- Кнопка Отменить бронирование -->
        <Button
            android:id="@+id/cancelReservationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отменить"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Кнопка Скрыть (для админов) -->
    <Button
        android:id="@+id/hideButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Скрыть"
        android:visibility="gone" />

    <!-- Кнопка Удалить (для админов) -->
    <Button
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Удалить"
        android:visibility="gone" />
</LinearLayout>
